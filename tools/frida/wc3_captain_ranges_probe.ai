function main takes nothing returns nothing
    call SetCampaignAI()
    call CreateCaptains()
    call SetCaptainHome(1,-1936.0,-144.0)
    call InitAssault()
    call AddAssault(1,'hCR0')
    call AddAssault(1,'hCR1')
    call AddAssault(1,'hCR2')
    call AddAssault(1,'hCR3')
    call AddAssault(1,'hCR4')
    call AddAssault(1,'hCR5')
    call Sleep(5.0)
    call Preload("PATHRANGE fresh nonmissile recruit")
    call AddAssault(2,'hCR5')
    loop
        call Sleep(1.0)
    endloop
endfunction
