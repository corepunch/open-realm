function main takes nothing returns nothing
    call DisplayText(GetAiPlayer(), "query test\n")
    call DisplayTextI(GetAiPlayer(), "one %d\n", 1)
    call DisplayTextII(GetAiPlayer(), "two %d %d\n", 1, 2)
    call DisplayTextIII(GetAiPlayer(), "three %d %d %d\n", 1, 2, 3)
    if GetUnitCount('hfoo') != 3 then
        call MissingAIAction()
    endif
    if GetUnitCountDone('hfoo') != 1 then
        call MissingAIAction()
    endif
    if GetPlayerUnitTypeCount(Player(2), 'hfoo') != 3 then
        call MissingAIAction()
    endif
    if GetPlayerUnitTypeCount(Player(1), 'hfoo') != 1 then
        call MissingAIAction()
    endif
    if GetUnitGoldCost('hbar') != 235 or GetUnitWoodCost('hbar') != 85 then
        call MissingAIAction()
    endif
    if GetUnitBuildTime('hfoo') != 60 or GetUnitBuildTime('xxxx') != 0 then
        call MissingAIAction()
    endif
    if GetUnitCount('hbar') != 1 or GetUnitCountDone('hbar') != 0 then
        call MissingAIAction()
    endif
    if GetUpgradeLevel('Rhme') != 2 then
        call MissingAIAction()
    endif
    if GetMinesOwned() != 1 or GetGoldOwned() != 1000 then
        call MissingAIAction()
    endif
    if TownWithMine() != 0 or not TownHasMine(0) or not TownHasHall(0) then
        call MissingAIAction()
    endif
    if TownHasMine(1) or TownHasHall(1) then
        call MissingAIAction()
    endif
    call Sleep(10)
endfunction