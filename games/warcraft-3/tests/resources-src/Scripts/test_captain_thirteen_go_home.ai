function main takes nothing returns nothing
    call Preload("PATHCAPTAIN home begin")
    call SetCampaignAI()
    call CreateCaptains()
    call SetCaptainHome(1,-1936.0,-144.0)
    call InitAssault()
    call Preload("PATHCAPTAIN home before recruit")
    if AddAssault(1,'hBGL') and AddAssault(12,'hBGM') then
        call Preload("PATHCAPTAIN home accepted")
    else
        call Preload("PATHCAPTAIN home rejected")
    endif
    if CaptainGroupSize()==13 then
        call Preload("PATHCAPTAIN thirteen mixed roster thirteen")
    else
        call Preload("PATHCAPTAIN pair roster wrong")
    endif
    call Sleep(17.0)
    call Preload("PATHCAPTAIN thirteen before south home")
    call SetCaptainHome(1,-1936.0,-1424.0)
    call Preload("PATHCAPTAIN thirteen after south home")
    call Preload("PATHCAPTAIN thirteen before go home")
    call CaptainGoHome()
    call Preload("PATHCAPTAIN thirteen after go home")
    loop
        call Sleep(1.0)
    endloop
endfunction
