Frame "FRAME" "OpenWarcraftMessageOverlay" {
    SetAllPoints,

    Frame "TEXTAREA" "OpenWarcraftMessageText" {
        Width 0.30,
        Height 0.145,
        SetPoint TOPLEFT, "OpenWarcraftMessageOverlay", TOPLEFT, 0.05, -0.30,
        FrameFont "MasterFont", 0.010, "",
        TextAreaInset 0.0,
    }
}
