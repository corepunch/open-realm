// Blizzard templates own the skins; these final templates own OpenWarcraft's dialog composition.
Frame "DIALOG" "OpenWarcraftStandardDialog" INHERITS WITHCHILDREN "StandardDialogTemplate" {
    Frame "TEXT" "DialogText" INHERITS "StandardInfoTextTemplate" {
        Width 0.48,
        Height 0.25,
        SetPoint TOPLEFT, "OpenWarcraftStandardDialog", TOPLEFT, 0.06, -0.055,
        FontJustificationH JUSTIFYLEFT,
        FontJustificationV JUSTIFYTOP,
    }

    Frame "TEXTBUTTON" "DialogButtonOK" INHERITS WITHCHILDREN "StandardButtonTemplate" {
        Width 0.159,
        Height 0.031,
        SetPoint BOTTOM, "OpenWarcraftStandardDialog", BOTTOM, 0.0, 0.045,
        ButtonText "DialogButtonOKText",
        Frame "TEXT" "DialogButtonOKText" INHERITS "StandardButtonTextTemplate" {
            Text "OK",
        }
    }
}

Frame "DIALOG" "OpenWarcraftBattleNetDialog" INHERITS WITHCHILDREN "BattleNetDialogTemplate" {
    Frame "TEXT" "DialogText" INHERITS "StandardInfoTextTemplate" {
        Width 0.48,
        Height 0.25,
        SetPoint TOPLEFT, "OpenWarcraftBattleNetDialog", TOPLEFT, 0.06, -0.055,
        FontJustificationH JUSTIFYLEFT,
        FontJustificationV JUSTIFYTOP,
    }

    Frame "TEXTBUTTON" "DialogButtonOK" INHERITS WITHCHILDREN "BattleNetBorderedButtonTemplate" {
        Width 0.18,
        Height 0.031,
        SetPoint BOTTOM, "OpenWarcraftBattleNetDialog", BOTTOM, 0.0, 0.045,
        ButtonText "DialogButtonOKText",
        Frame "TEXT" "DialogButtonOKText" INHERITS "BattleNetButtonTextTemplate" {
            Text "OK",
        }
    }
}

Frame "DIALOG" "OpenWarcraftScriptDialog" INHERITS WITHCHILDREN "ScriptDialog" {
    Frame "GLUETEXTBUTTON" "DialogButtonOK" INHERITS WITHCHILDREN "ScriptDialogButton" {
        Width 0.159,
        Height 0.031,
        SetPoint BOTTOM, "OpenWarcraftScriptDialog", BOTTOM, 0.0, 0.015,
        ButtonText "ScriptDialogButtonText",
    }
}
